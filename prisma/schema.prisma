datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Food {
  id            Int     @id @default(autoincrement())
  artikul       String?
  title         String?
  price         Float   @default(0.0)
  priceDiscount Float   @default(0.0)
  vat           Boolean @default(false)
  isPromo       Boolean @default(false)
  ozonId        String?

  img     String?
  imgUrl  String?
  imgs    String?      @db.Text
  imgsAdd FoodImgAdd[]

  feature          String?
  weight           Int?
  quantity         Int?
  quantityPackages Int?
  type             FoodType

  expiration  Int?
  annotation  String? @db.Text
  packageSize String?

  tasteId Int?
  taste   Taste? @relation(fields: [tasteId], references: [id])

  ingredientId Int?
  ingredient   ingredient? @relation(fields: [ingredientId], references: [id])

  hardnessId Int?
  hardness   Hardness? @relation(fields: [hardnessId], references: [id])

  designed     FoodDesignedFor[]
  ages         FoodAge[]
  typeTreats   FoodTypeTreat[]
  petSizes     FoodPetSize[]
  foodPackage  FoodPackage[]
  specialNeeds FoodSpecialNeeds[]
  ratings      Rating[]
  orders       Order[]
  publishedAt  DateTime           @default(now()) @map("published_at") @db.DateTime(0)
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  stock        Int                @default(0)

  @@index([tasteId])
  @@index([ingredientId])
  @@index([hardnessId])
  @@map("foods")
}

model DesignedFor {
  id    Int               @id @default(autoincrement())
  name  String            @unique
  foods FoodDesignedFor[]
}

model FoodDesignedFor {
  foodId        Int
  designedForId Int
  food          Food        @relation(fields: [foodId], references: [id])
  designedFor   DesignedFor @relation(fields: [designedForId], references: [id])

  @@id([foodId, designedForId])
}

model TypeTreat {
  id    Int             @id @default(autoincrement())
  name  String          @unique
  foods FoodTypeTreat[]
}

model FoodTypeTreat {
  foodId      Int
  typeTreatId Int
  food        Food      @relation(fields: [foodId], references: [id])
  typeTreat   TypeTreat @relation(fields: [typeTreatId], references: [id])

  @@id([foodId, typeTreatId])
}

model Age {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  foods FoodAge[]
}

model FoodAge {
  foodId Int
  ageId  Int
  food   Food @relation(fields: [foodId], references: [id])
  age    Age  @relation(fields: [ageId], references: [id])

  @@id([foodId, ageId])
}

// model Brand {
//   id    Int    @id @default(autoincrement())
//   name  String @unique
//   foods Food[]
// }

model Taste {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model ingredient {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model Hardness {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model Package {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  foods FoodPackage[]
}

model FoodPackage {
  foodId    Int
  packageId Int
  food      Food    @relation(fields: [foodId], references: [id])
  package   Package @relation(fields: [packageId], references: [id])

  @@id([foodId, packageId])
}

model PetSize {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  foods FoodPetSize[]
}

model FoodPetSize {
  foodId    Int
  petSizeId Int
  food      Food    @relation(fields: [foodId], references: [id])
  petSize   PetSize @relation(fields: [petSizeId], references: [id])

  @@id([foodId, petSizeId])
}

model SpecialNeeds {
  id    Int                @id @default(autoincrement())
  name  String             @unique
  foods FoodSpecialNeeds[]
}

model FoodSpecialNeeds {
  foodId         Int
  specialNeedsId Int
  food           Food         @relation(fields: [foodId], references: [id])
  specialNeeds   SpecialNeeds @relation(fields: [specialNeedsId], references: [id])

  @@id([foodId, specialNeedsId])
}

model User {
  id       Int     @id @default(autoincrement())
  balance  Decimal @default(0.0) @db.Decimal(15, 2)
  //nickname String  @unique(map: "nickname") @db.VarChar(100)
  email    String  @unique(map: "email") @db.VarChar(100)
  password String? @db.VarChar(256)

  //phone String @unique(map: "phone") @db.VarChar(100)
  name            String?           @db.VarChar(256)
  authType        AuthType?
  ratings         Rating[]
  orders          Order[]
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  UserConfirmCode UserConfirmCode[]

  @@map("users")
}

model UserConfirmCode {
  user      User      @relation(fields: [userId], references: [id])
  userId    Int       @map("user_id")
  code      String
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  tryDate   DateTime? @map("try_date")
  uuid      String    @unique(map: "uuid") @db.VarChar(100)

  @@id([userId, uuid])
  @@map("user_confirm_code")
}

model Order {
  id        Int      @id @default(autoincrement())
  food      Food     @relation(fields: [foodId], references: [id])
  foodId    Int      @map("food_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @map("user_id")
  quantity  Int
  orderNum  Int
  orderedAt DateTime @default(now()) @map("ordered_at") @db.DateTime(0)

  @@index([foodId])
  @@map("orders")
}

model Rating {
  food    Food     @relation(fields: [foodId], references: [id])
  foodId  Int      @map("food_id")
  user    User     @relation(fields: [userId], references: [id])
  userId  Int      @map("user_id")
  score   Int      @db.TinyInt
  ratedAt DateTime @default(now()) @map("rated_at") @db.DateTime(0)

  @@id([foodId, userId])
  @@unique([foodId, userId], map: "uniq_food_user_idx")
  @@map("ratings")
}

enum FoodType {
  Treat // "S": "Лакомство",
  Souvenirs
  DryFood

  @@map("foods_type")
}

enum AuthType {
  ConfirmCode
  Password

  @@map("auth_type")
}

model FoodImgAdd {
  food   Food @relation(fields: [foodId], references: [id])
  foodId Int  @map("food_id")

  img String @db.VarChar(256)

  @@id([foodId, img])
  @@map("food_imgs_add")
}
