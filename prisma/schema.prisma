model Taste {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model ingredient {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model Hardness {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

