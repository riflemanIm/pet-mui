datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Food {
  id                 Int     @id @default(autoincrement())
  artikul            String?
  title              String?
  price              Float   @default(0.0)
  priceDiscount      Float   @default(0.0)
  vat                Boolean @default(false)
  isPromo            Boolean @default(false)
  ozonId             String?
  barcode            String?
  packageSize        String?
  img                String?
  imgUrl             String?
  imgs               Json?
  feature            String?
  annotation         String?
  keywords           String?
  composition        String?
  materials          String?
  weight             Int?
  quantity           Int?
  quantityPackages   Int?
  possibleStartMonth Int?
  numInPackage       Int?
  proteins           Float?
  fats               Float?
  contentOfMeet      Int?
  energyValue        Int?
  expiration         Int?
  type               String?

  brandId        Int?
  brand          Brand?        @relation(fields: [brandId], references: [id])
  tasteId        Int?
  taste          Taste?        @relation(fields: [tasteId], references: [id])
  ingridientId   Int?
  ingridient     Ingridient?   @relation(fields: [ingridientId], references: [id])
  hardnessId     Int?
  hardness       Hardness?     @relation(fields: [hardnessId], references: [id])
  specialNeedsId Int?
  specialNeeds   SpecialNeeds? @relation(fields: [specialNeedsId], references: [id])
  madeInId       Int?
  madeIn         MadeIn?       @relation(fields: [madeInId], references: [id])

  designed     FoodDesignedFor[]
  ages         FoodAge[]
  packages     FoodPackage[]
  typeTreats   FoodTypeTreat[]
  petSizes     FoodPetSize[]
  featuresList FoodFeature[]
}

model DesignedFor {
  id    Int               @id @default(autoincrement())
  name  String            @unique
  foods FoodDesignedFor[]
}

model FoodDesignedFor {
  foodId        Int
  designedForId Int
  food          Food        @relation(fields: [foodId], references: [id])
  designedFor   DesignedFor @relation(fields: [designedForId], references: [id])

  @@id([foodId, designedForId])
}

model Age {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  foods FoodAge[]
}

model FoodAge {
  foodId Int
  ageId  Int
  food   Food @relation(fields: [foodId], references: [id])
  age    Age  @relation(fields: [ageId], references: [id])

  @@id([foodId, ageId])
}

model Brand {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model Taste {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model Ingridient {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model Hardness {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model SpecialNeeds {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model MadeIn {
  id    Int    @id @default(autoincrement())
  name  String @unique
  foods Food[]
}

model Package {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  foods FoodPackage[]
}

model TypeTreat {
  id    Int             @id @default(autoincrement())
  name  String          @unique
  foods FoodTypeTreat[]
}

model PetSize {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  foods FoodPetSize[]
}

model Feature {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  foods FoodFeature[]
}

model FoodPackage {
  foodId    Int
  packageId Int
  food      Food    @relation(fields: [foodId], references: [id])
  package   Package @relation(fields: [packageId], references: [id])

  @@id([foodId, packageId])
}

model FoodTypeTreat {
  foodId      Int
  typeTreatId Int
  food        Food      @relation(fields: [foodId], references: [id])
  typeTreat   TypeTreat @relation(fields: [typeTreatId], references: [id])

  @@id([foodId, typeTreatId])
}

model FoodPetSize {
  foodId    Int
  petSizeId Int
  food      Food    @relation(fields: [foodId], references: [id])
  petSize   PetSize @relation(fields: [petSizeId], references: [id])

  @@id([foodId, petSizeId])
}

model FoodFeature {
  foodId    Int
  featureId Int
  food      Food    @relation(fields: [foodId], references: [id])
  feature   Feature @relation(fields: [featureId], references: [id])

  @@id([foodId, featureId])
}
