datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Food {
  id            Int     @id @default(autoincrement())
  artikul       String?
  title         String?
  price         Float   @default(0.0)
  priceDiscount Float   @default(0.0)
  vat           Boolean @default(false)
  isPromo       Boolean @default(false)
  ozonId        String?

  imgUrl String?
  imgs   String? @db.Text

  feature          String?
  weight           Int?
  quantity         Int?
  quantityPackages Int?
  type             String?

  expiration  Int?
  annotation  String? @db.Text
  packageSize String?

  tasteId Int?
  taste   Taste? @relation(fields: [tasteId], references: [id])

  ingredientId Int?
  ingredient   ingredient? @relation(fields: [ingredientId], references: [id])

  hardnessId Int?
  hardness   Hardness? @relation(fields: [hardnessId], references: [id])

  designed    FoodDesignedFor[]
  ages        FoodAge[]
  typeTreats  FoodTypeTreat[]
  petSizes    FoodPetSize[]
  foodPackage FoodPackage[]
  // FoodFeature    FoodFeature[]
}

model DesignedFor {
  id    Int               @id @default(autoincrement())
  name  String            @unique
  foods FoodDesignedFor[]
}

model FoodDesignedFor {
  foodId        Int
  designedForId Int
  food          Food        @relation(fields: [foodId], references: [id])
  designedFor   DesignedFor @relation(fields: [designedForId], references: [id])

  @@id([foodId, designedForId])
}

model TypeTreat {
  id    Int             @id @default(autoincrement())
  name  String          @unique
  foods FoodTypeTreat[]
}

model FoodTypeTreat {
  foodId      Int
  typeTreatId Int
  food        Food      @relation(fields: [foodId], references: [id])
  typeTreat   TypeTreat @relation(fields: [typeTreatId], references: [id])

  @@id([foodId, typeTreatId])
}

model Age {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  foods FoodAge[]
}

model FoodAge {
  foodId Int
  ageId  Int
  food   Food @relation(fields: [foodId], references: [id])
  age    Age  @relation(fields: [ageId], references: [id])

  @@id([foodId, ageId])
}

