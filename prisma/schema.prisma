model Package {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  foods FoodPackage[]
}

model FoodPackage {
  foodId    Int
  packageId Int
  food      Food    @relation(fields: [foodId], references: [id])
  package   Package @relation(fields: [packageId], references: [id])

  @@id([foodId, packageId])
}

model PetSize {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  foods FoodPetSize[]
}

model FoodPetSize {
  foodId    Int
  petSizeId Int
  food      Food    @relation(fields: [foodId], references: [id])
  petSize   PetSize @relation(fields: [petSizeId], references: [id])

  @@id([foodId, petSizeId])
}

